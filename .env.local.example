# ── Supabase (required) ───────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Used in both the browser (image uploads) and the server (API route fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose in the browser (used for Storage uploads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Used by /api/register to bypass RLS. If omitted, falls back to anon key
# (RLS "allow anon insert" policy must exist in that case).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
