# Shared PostgreSQL database
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/probodham_cricket
#
# Render production example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/probodham_cricket

# Use `disable` for local PostgreSQL and `require` for Render PostgreSQL.
PGSSLMODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Public app URL for production deployment on Vercel.
NEXT_PUBLIC_SITE_URL=https://your-vercel-project.vercel.app

# Render backend URL for the external admin panel only.
NEXT_PUBLIC_API_BASE_URL=https://probodham-cricket-registration.onrender.com

# UPI payment config for the external success screen.
NEXT_PUBLIC_UPI_ID=rnitin1964@okhdfcbank
NEXT_PUBLIC_UPI_PAYEE_NAME=Raju Shah
NEXT_PUBLIC_UPI_AMOUNT=500
NEXT_PUBLIC_UPI_NOTE_PREFIX=APL Reg

# Cloudinary unsigned upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# OpenRouter avatar generation
OPENROUTER_API_KEY=your-openrouter-api-key
